<%- include('../partials/layout_start', { title: 'Reports' }) %>

<h1 class="h5 mb-3"><i class="bi bi-file-earmark-bar-graph me-2"></i>Reports</h1>
<p class="text-muted small">Downloads require permission for the event — admins for all events, teachers for their assigned events. Spreadsheets and CSVs include formula-injection protection for untrusted text.</p>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>Event</th><th>When</th><th>Status</th><th class="text-end">Downloads</th></tr></thead>
      <tbody>
        <% for (const e of events) { %>
          <tr>
            <td class="fw-semibold"><%= e.title %><div class="small text-muted"><%= e.venue_name %></div></td>
            <td class="small"><%= fmt.dt(e.start_at, timezone) %></td>
            <td><span class="badge text-bg-<%= e.status === 'published' ? 'success' : 'secondary' %>"><%= e.status %></span></td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-secondary" href="<%= basePath %>/<%= e.id %>/reports/attendance.csv">CSV</a>
              <a class="btn btn-sm btn-outline-secondary" href="<%= basePath %>/<%= e.id %>/reports/attendance.xlsx">Excel</a>
              <a class="btn btn-sm btn-outline-secondary" href="<%= basePath %>/<%= e.id %>/reports/attendance.pdf">PDF</a>
              <a class="btn btn-sm btn-outline-secondary" href="<%= basePath %>/<%= e.id %>/reports/signin-sheet.pdf">Sign-in sheet</a>
            </td>
          </tr>
        <% } %>
        <% if (!events.length) { %>
          <tr><td colspan="4" class="text-center text-muted py-4">No events yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/layout_end') %>
