<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Error' %></title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-app">
  <main class="d-flex align-items-center justify-content-center min-vh-100 p-3">
    <div class="text-center">
      <div class="display-1 fw-bold text-primary"><i class="bi bi-exclamation-triangle"></i></div>
      <h1 class="h4 mb-3"><%= typeof title !== 'undefined' ? title : 'Something went wrong' %></h1>
      <p class="text-muted mb-4"><%= typeof message !== 'undefined' && message ? message : 'Please try again.' %></p>
      <a class="btn btn-primary" href="/">Go back home</a>
    </div>
  </main>
</body>
</html>
