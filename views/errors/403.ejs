<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Access denied</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-app">
  <main class="d-flex align-items-center justify-content-center min-vh-100 p-3">
    <div class="text-center">
      <div class="display-1 fw-bold text-primary">403</div>
      <h1 class="h4 mb-3">Access denied</h1>
      <p class="text-muted mb-4"><%= typeof message !== 'undefined' && message ? message : 'You do not have permission to view this page.' %></p>
      <a class="btn btn-primary" href="/">Go back home</a>
    </div>
  </main>
</body>
</html>
