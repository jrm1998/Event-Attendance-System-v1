<%- include('../partials/layout_start', { title: 'Manual Check-in' }) %>

<h1 class="h5 mb-3"><i class="bi bi-person-check me-2"></i>Manual Check-in</h1>
<p class="text-muted small">
  Open your event's attendance console to search students and record manual entries
  (present / late / absent), record check-outs or correct statuses. Every action requires a
  reason and is written to the attendance audit trail.
</p>

<div class="list-group shadow-sm">
  <% for (const e of events) { %>
    <div class="list-group-item d-flex justify-content-between align-items-center">
      <div>
        <div class="fw-semibold"><%= e.title %></div>
        <div class="small text-muted"><%= fmt.dt(e.start_at, timezone) %> · <%= e.venue_name %></div>
      </div>
      <a class="btn btn-sm btn-outline-primary" href="/teacher/events/<%= e.id %>/attendance">Open console</a>
    </div>
  <% } %>
  <% if (!events.length) { %>
    <div class="list-group-item text-muted">No assigned events.</div>
  <% } %>
</div>

<%- include('../partials/layout_end') %>
