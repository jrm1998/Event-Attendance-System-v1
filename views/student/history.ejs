<%- include('../partials/layout_start', { title: 'My Attendance' }) %>

<h1 class="h4 mb-3"><i class="bi bi-journal-check me-2"></i>My Attendance <span class="text-muted small">(<%= total %>)</span></h1>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead><tr><th>Event</th><th>Date</th><th>Status</th><th>Checked in</th><th>Checked out</th></tr></thead>
      <tbody>
        <% if (!rows.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No attendance records yet.</td></tr><% } %>
        <% for (const r of rows) { %>
          <tr>
            <td class="fw-semibold"><%= r.event_title %><div class="small text-muted"><%= r.venue_name %></div></td>
            <td class="small"><%= fmt.dt(r.start_at, timezone) %></td>
            <td><span class="badge badge-status-<%= r.status %>"><%= r.status.replace('_',' ') %></span>
              <% if (r.status === 'pending_review') { %><div class="small text-muted">under review</div><% } %></td>
            <td class="small"><%= r.checkin_at ? fmt.dt(r.checkin_at, timezone) : '—' %></td>
            <td class="small"><%= r.checkout_at ? fmt.dt(r.checkout_at, timezone) : '—' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div class="card-footer bg-white d-flex justify-content-between align-items-center">
    <span class="small text-muted">Page <%= page %> of <%= totalPages %></span>
    <nav><ul class="pagination pagination-sm mb-0">
      <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="/student/history?page=<%= page - 1 %>">Prev</a></li>
      <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="/student/history?page=<%= page + 1 %>">Next</a></li>
    </ul></nav>
  </div>
</div>

<%- include('../partials/layout_end') %>
