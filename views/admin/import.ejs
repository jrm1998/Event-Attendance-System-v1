<%- include('../partials/layout_start', { title: 'Import Students' }) %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-9">
    <div class="card shadow-sm">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h1 class="h5 mb-0"><i class="bi bi-upload me-2"></i>Import Students (CSV / Excel)</h1>
        <a class="btn btn-sm btn-outline-secondary" href="/admin/students">Back</a>
      </div>
      <div class="card-body">
        <p class="small text-muted">
          Required columns: <code>student_number, first_name, last_name</code>.
          Optional: <code>middle_name, email, grade_level, section, username, password</code>.
          Grade/section are matched by name (e.g. <code>Grade 7</code>, <code>Sampaguita</code>).
          Duplicate numbers/usernames are skipped and reported.
        </p>
        <div class="mb-3">
          <label class="form-label" for="import-file">Spreadsheet file</label>
          <input type="file" class="form-control" id="import-file" accept=".csv,.xlsx">
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-outline-primary" id="validate-btn" type="button"><i class="bi bi-clipboard-check me-1"></i>Validate file</button>
          <button class="btn btn-primary d-none" id="commit-btn" type="button"><i class="bi bi-check2-all me-1"></i>Import valid rows</button>
        </div>
        <div id="import-progress" class="alert alert-info d-none mt-3 small"><span class="spinner-border spinner-border-sm me-2"></span>Working…</div>
        <div id="import-report" class="mt-3"></div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/layout_end', { pageScripts: ['/js/import-page.js'] }) %>
