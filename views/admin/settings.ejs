<%- include('../partials/layout_start', { title: 'System Settings' }) %>

<h1 class="h5 mb-3"><i class="bi bi-gear me-2"></i>System Settings</h1>

<% if (saved) { %>
  <div class="alert alert-success py-2"><i class="bi bi-check-circle me-1"></i>Settings saved.</div>
<% } %>

<form method="post" action="/admin/settings" class="card shadow-sm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <div class="row g-3">
      <% for (const f of fields) { %>
        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold mb-1" for="set-<%= f.key.replace(/\./g, '-') %>"><%= f.label %></label>
          <% if (f.type === 'bool') { %>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="set-<%= f.key.replace(/\./g, '-') %>"
                     name="<%= f.key %>" <%= f.value === 'true' ? 'checked' : '' %>>
            </div>
          <% } else if (f.type === 'number') { %>
            <input class="form-control" type="number" step="<%= f.step || '1' %>" min="<%= f.min %>" max="<%= f.max %>"
                   id="set-<%= f.key.replace(/\./g, '-') %>" name="<%= f.key %>" value="<%= f.value %>">
          <% } else { %>
            <input class="form-control" type="text" id="set-<%= f.key.replace(/\./g, '-') %>"
                   name="<%= f.key %>" value="<%= f.value %>" maxlength="120">
          <% } %>
          <% if (f.help) { %><div class="form-text"><%= f.help %></div><% } %>
        </div>
      <% } %>
    </div>
  </div>
  <div class="card-footer bg-white d-flex justify-content-end gap-2">
    <a class="btn btn-outline-secondary btn-sm" href="/admin/settings">Reset</a>
    <button class="btn btn-primary btn-sm" type="submit">Save settings</button>
  </div>
</form>

<div class="alert alert-secondary small mt-3">
  Changing QR rotation takes effect on the next issued token. GPS and absence settings apply to new
  submissions and finalizer runs immediately. Values are cached for up to 30 seconds.
</div>

<%- include('../partials/layout_end') %>
