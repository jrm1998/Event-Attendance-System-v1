<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · <%= schoolName %></title>
  <meta name="theme-color" content="#1a3a5c">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/icon-192.png" type="image/png">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-app" data-csrf="<%= csrfToken %>" data-user-id="" data-user-role="" data-school-tz="<%= timezone %>" data-school-name="<%= schoolName %>">
  <main class="d-flex align-items-center justify-content-center min-vh-100 p-3">
    <div class="card login-card shadow-sm w-100" style="max-width: 420px;">
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <div class="login-logo mb-2"><i class="bi bi-qr-code-scan"></i></div>
          <h1 class="h4 mb-1"><%= schoolName %></h1>
          <p class="text-muted small mb-0">Event Attendance System</p>
        </div>
        <% for (const f of flashes) { %>
          <div class="alert alert-<%= f.type === 'error' ? 'danger' : f.type %> py-2 small"><%= f.message %></div>
        <% } %>
        <form method="post" action="/login" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-person"></i></span>
              <input type="text" class="form-control" id="username" name="username" autocomplete="username" required autofocus
                     value="<%= typeof savedUsername !== 'undefined' ? savedUsername : '' %>">
            </div>
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-lock"></i></span>
              <input type="password" class="form-control" id="password" name="password" autocomplete="current-password" required>
            </div>
          </div>
          <button type="submit" class="btn btn-primary w-100 py-2">
            <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
          </button>
        </form>
        <hr class="my-4">
        <p class="small text-muted mb-1"><i class="bi bi-shield-check me-1"></i>Students sign in with their student number.</p>
        <p class="small text-muted mb-0"><i class="bi bi-wifi-off me-1"></i>Offline? Attendance scanning needs an internet connection.</p>
      </div>
    </div>
  </main>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js" defer></script>
  <script src="/js/connection-status.js" defer></script>
  <script src="/js/service-worker-registration.js" defer></script>
  <script src="/js/pwa-install.js" defer></script>
</body>
</html>
